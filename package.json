{
  "name": "ro-survivors-helper",
  "version": "2.0.1",
  "private": true,
  "description": "Client-side Tampermonkey helper for ro.hans-webgametw.com",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:equipment": "node scripts/build-equipment-page.mjs",
    "test": "npm run build && npm run build:equipment && node tests/auto-pick.test.cjs && node tests/stage-observer.test.cjs && node tests/safari-diagnostics.test.cjs && node tests/inventory.test.cjs && node tests/equipment-page.test.cjs",
    "test:publish": "npm run build && node tests/publish-greasyfork.test.mjs",
    "check:greasyfork": "npm run build && node scripts/publish-greasyfork.mjs --dry-run",
    "publish:greasyfork": "npm test && node scripts/push-greasyfork.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "linkedom": "0.18.15"
  }
}
